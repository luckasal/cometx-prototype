# Public project configuration (safe for browser use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public GA4 Measurement ID (G-...), configured at build time; no ID is hardcoded.
VITE_GA_MEASUREMENT_ID=
# Server-only GA4 Data API reporting for /admin/analytics (numeric property ID, not G- ID).
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Server only. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
CRON_SECRET=
CRON_SECRET_PREVIOUS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=http://localhost:3001
# APP_URL overrides SITE_URL when configured; use the deployed origin.
APP_URL=
# Enable only once a sender is verified. Secure guest links work independently.
TICKET_EMAIL_MODE=disabled
RESEND_API_KEY=
