# Public project configuration (safe for browser use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public GA4 Measurement ID (G-...), configured at build time; no ID is hardcoded.
VITE_GA_MEASUREMENT_ID=
# Server-only GA4 Data API reporting for /admin/analytics (numeric property ID, not G- ID).
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Server only. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
CRON_SECRET=
CRON_SECRET_PREVIOUS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe remains the invoice ledger. The server generates an extra SIX Swiss QR-bill page for unpaid CHF/EUR invoices.
COMETX_QR_CREDITOR_IBAN=
COMETX_QR_CREDITOR_NAME=
COMETX_QR_CREDITOR_STREET=
COMETX_QR_CREDITOR_BUILDING_NUMBER=
COMETX_QR_CREDITOR_POSTAL_CODE=
COMETX_QR_CREDITOR_CITY=
COMETX_QR_CREDITOR_COUNTRY=CH
# Bank provider adapter sends normalized, signed transactions to /api/public/bank-feed.
BANK_FEED_PROVIDER=
BANK_FEED_ACCOUNT_ID=
BANK_FEED_WEBHOOK_SECRET=
SITE_URL=http://localhost:3001
# APP_URL overrides SITE_URL when configured; use the deployed origin.
APP_URL=
# Enable only once a sender is verified. Secure guest links work independently.
TICKET_EMAIL_MODE=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
